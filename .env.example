# Copy to .env and fill in. Never commit .env or real secrets.

# --- App ---
APP_ENV=development
APP_NAME=Qorvexa
FRONTEND_URL=http://localhost:5173   # public address of the app (used in emails); http://localhost:8000 with `make serve`
# FRONTEND_DIST_DIR=../frontend/dist  # set to also serve the built web app from the API (production shape, ADR-0015); CORS is then unnecessary
MAX_PROFILES_PER_ACCOUNT=5
PUBLIC_MATURITY_LIMIT=13+   # audience limit for anonymous / no-profile requests
TRUSTED_PROXY_COUNT=0   # 1 behind one trusted reverse proxy (verify per host)
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Database ---
POSTGRES_USER=qorvexa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qorvexa
DATABASE_URL=postgresql+asyncpg://qorvexa:change-me@localhost:5432/qorvexa

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=generate-a-long-random-value
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10   # 0 = strict: any reuse of a rotated refresh token revokes the session
COOKIE_SECURE=false

# --- Video provider: "cloudinary" | "mux" | "r2" | "local" ---
VIDEO_PROVIDER=local
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Cloudinary (pilot video provider, ADR-0011). Never commit real values. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WARN_PERCENT=70
CLOUDINARY_BLOCK_PERCENT=90

# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=qorvexa-media
S3_REGION=auto

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@qorvexa.local

# --- Observability (optional) ---
SENTRY_DSN=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000

# --- Seed script (make seed). No default password exists; set both or no admin is created. ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
